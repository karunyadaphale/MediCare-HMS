# MediCare HMS - Environment Configuration
# Copy this file to .env and configure your values

# Flask Secret Key for Session Security & CSRF
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# MongoDB Atlas Connection URI
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Example Local URI: mongodb://localhost:27017/
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=medicare_hms

# Default Initial Administrator Account (for seed.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@medicare.local
ADMIN_NAME=System Administrator

# Server Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
